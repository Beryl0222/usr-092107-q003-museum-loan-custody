{
  "event_type": "EXCURSION_REPORTED",
  "aggregate_type": "environment_excursion",
  "description": "超阈值窗口；同一窗口随补报延伸时以新版本续报，excursion_key 保持稳定。",
  "payload_required": ["excursion_key", "sensor_id", "metric", "window", "extreme", "threshold"],
  "payload_fields": {
    "excursion_key": "窗口键：传感器:指标:起始时刻(UTC)",
    "sensor_id": "传感器编号",
    "metric": "指标",
    "window": "{ start, end } UTC 窗口",
    "extreme": "{ value, unit } 极值",
    "threshold": "{ min?, max? } 被突破的阈值",
    "case_id": "可选，关联箱件",
    "reading_count": "可选，窗口内读数条数"
  }
}
