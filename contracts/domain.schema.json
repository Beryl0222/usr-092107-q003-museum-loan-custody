{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "跨馆木雕借展护送台领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "OBJECT_PACKED",
        "CUSTODY_TRANSFERRED",
        "CONDITION_INSPECTED",
        "EXCURSION_REPORTED",
        "RETURN_ACCEPTED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "collection_object",
        "shipping_case",
        "custody_handoff",
        "condition_incident"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
